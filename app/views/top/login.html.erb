<h1>ログイン</h1>

<%= form_with url: top_login_path, method: :post, local: true do |f| %>
  <p>
    <%= f.label :uid, "ユーザーID" %>
    <%= f.text_field :uid %>
  </p>
  <p>
    <%= f.label :pass, "パスワード" %>
    <%= f.password_field :pass %>
  </p>
  <%= f.submit "ログイン" %>
<% end %>

<%= link_to '新規登録', new_user_path %>